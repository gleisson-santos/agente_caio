# CaioCore Environment Variables
# Copy this file to .env and fill in your values

# Provider API Keys
OPENROUTER_API_KEY=your_openrouter_key
GEMINI_API_KEY=your_gemini_key
DEEPSEEK_API_KEY=your_deepseek_key
OPENAI_API_KEY=your_openai_key
GROQ_API_KEY=your_groq_key
ANTHROPIC_API_KEY=your_anthropic_key
OMNIROUTE_API_KEY=your_omniroute_key

# OmniRouter Configuration
OMNIROUTE_BASE_URL=http://89.167.22.145:20128/v1
OMNIROUTE_COMBO_ID=your_combo_id

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id

# Email (IMAP/SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Search
BRAVE_API_KEY=your_brave_key
TAVILY_API_KEY=your_tavily_key

# Google Calendar (optional – uses OAuth2 token file)
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=token.pickle
